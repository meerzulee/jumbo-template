#!/usr/bin/env bash
#
# ze - Zellij session launcher for Rails projects
#
# Usage: bin/ze [session_name] [layout_file]
#
set -euo pipefail

# --- Configuration ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PROJECT_NAME="$(basename "$PROJECT_ROOT")"

SESSION="${1:-$PROJECT_NAME}"
LAYOUT="${2:-$PROJECT_ROOT/.zellij/layout.kdl}"

# Resolve relative paths
[[ "$LAYOUT" = /* ]] || LAYOUT="$PROJECT_ROOT/$LAYOUT"

# --- Functions ---
die() { echo "Error: $1" >&2; exit "${2:-1}"; }

create_default_layout() {
  mkdir -p "$(dirname "$LAYOUT")"
  cat > "$LAYOUT" << 'EOF'
layout {
  tab name="editor" focus=true {
    pane command="bash" { args "-lc" "${EDITOR:-nvim} ."; }
  }
  tab name="server" {
    pane command="bash" { args "-lc" "bin/dev"; }
  }
  tab name="console" {
    pane command="bash" { args "-lc" "bin/rails console"; }
  }
  tab name="git" {
    pane command="bash" { args "-lc" "lazygit 2>/dev/null || git status"; }
  }
}
EOF
  echo "Created: $LAYOUT" >&2
}

find_session() {
  local sessions
  sessions=$(zellij list-sessions 2>/dev/null) || return 1
  
  # Exact match
  echo "$sessions" | grep -Fx "$SESSION" && return 0
  
  # Prefix match (session-xxx or session_xxx)
  local matches
  matches=$(echo "$sessions" | grep -E "^${SESSION}[-_]" || true)
  [[ $(echo "$matches" | grep -c .) -eq 1 ]] && echo "$matches"
}

# --- Main ---
command -v zellij &>/dev/null || die "zellij is not installed" 127

# Create default layout if missing
[[ -f "$LAYOUT" ]] || create_default_layout

# Already inside Zellij? Add tabs to current session
[[ -z "${ZELLIJ:-}" ]] || exec zellij action new-tab --layout "$LAYOUT"

# Try to attach to existing session
if match=$(find_session); then
  exec zellij attach "$match"
fi

# Create new session
exec zellij --layout "$LAYOUT" attach --create "$SESSION"
